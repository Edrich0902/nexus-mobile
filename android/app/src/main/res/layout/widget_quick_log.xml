<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_home"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="@string/widget_quick_log"
        android:textAllCaps="true"
        android:textColor="@color/widget_home_ink"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="serif"
        android:gravity="center_vertical"
        android:text="What are you having?"
        android:textColor="@color/widget_home_ink"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="-3dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quick_wine"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_pill"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Wine"
            android:textColor="@color/widget_home_acc_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/quick_beer"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_pill"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Beer"
            android:textColor="@color/widget_home_acc_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/quick_book"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_pill"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Book"
            android:textColor="@color/widget_home_acc_ink"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
